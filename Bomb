RunService.Heartbeat:Connect(function()
	if not unlocked then
		return
	end

	if not enabled then
		powerButton.Text = "SYSTEM  •  OFF"
		powerButton.BackgroundColor3 =
			Color3.fromRGB(50, 27, 32)

		autoButton.Text = "AUTO   •   OFF"
		autoButton.BackgroundColor3 =
			Color3.fromRGB(20, 24, 31)

		playButton.Text = "PLAY   •   OFF"
		playButton.BackgroundColor3 =
			Color3.fromRGB(20, 24, 31)

		stopSpin()
		return
	end

	powerButton.Text = "SYSTEM  •  ON"
	powerButton.BackgroundColor3 =
		Color3.fromRGB(25, 90, 57)

	updateMode()

	if currentMode == "AUTO" then
		autoButton.Text = "AUTO   •   ACTIVE"
		autoButton.BackgroundColor3 =
			Color3.fromRGB(25, 90, 57)
		autoButton.TextColor3 =
			Color3.fromRGB(225, 255, 235)

		playButton.Text = "PLAY   •   WAITING"
		playButton.BackgroundColor3 =
			Color3.fromRGB(20, 24, 31)
		playButton.TextColor3 =
			Color3.fromRGB(150, 160, 175)

		local tool = getInventoryTool()
		local heldTool = getHeldTool()

		if tool and not heldTool then
			local character = getCharacter()
			local humanoid = getHumanoid(character)

			if humanoid then
				humanoid:EquipTool(tool)
			end
		end

		local character = getCharacter()
		local humanoid = getHumanoid(character)
		local root = getRoot(character)

		if humanoid and root then
			local nearestPlayer =
				getNearestPlayer()

			if nearestPlayer then
				local targetRoot =
					getRoot(nearestPlayer.Character)

				if targetRoot then
					humanoid:MoveTo(
						targetRoot.Position
					)
				end
			end
		end

		local timer = findTimer()

		if timer
			and timer > 0
			and timer <= TRIGGER_TIME then

			startSpin()
		else
			stopSpin()
		end
	else
		autoButton.Text = "AUTO   •   WAITING"
		autoButton.BackgroundColor3 =
			Color3.fromRGB(20, 24, 31)
		autoButton.TextColor3 =
			Color3.fromRGB(150, 160, 175)

		playButton.Text = "PLAY   •   ACTIVE"
		playButton.BackgroundColor3 =
			Color3.fromRGB(25, 90, 57)
		playButton.TextColor3 =
			Color3.fromRGB(225, 255, 235)

		stopSpin()
		playMode()
	end

	doSpin()
end)

RunService.RenderStepped:Connect(function(deltaTime)
	rainbowTime += deltaTime * 1.5

	local r =
		math.sin(rainbowTime) * 127 + 128

	local g =
		math.sin(rainbowTime + 2) * 127 + 128

	local b =
		math.sin(rainbowTime + 4) * 127 + 128

	local color = Color3.fromRGB(
		math.floor(r),
		math.floor(g),
		math.floor(b)
	)

	rightsName.TextColor3 = color
	mini.TextColor3 = color
end)
