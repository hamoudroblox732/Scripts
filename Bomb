local function getCharacter()
	return player.Character
end

local function getHumanoid(character)
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(character)
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart")
end

local function getInventoryTool()
	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				return item
			end
		end
	end

	local character = getCharacter()

	if character then
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") then
				return item
			end
		end
	end

	return nil
end

local function getHeldTool()
	local character = getCharacter()

	if not character then return nil end

	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") then
			return item
		end
	end

	return nil
end

local function getNearestPlayer()
	local character = getCharacter()
	local root = getRoot(character)

	if not root then
		return nil, math.huge
	end

	local nearest = nil
	local nearestDistance = DETECTION_DISTANCE

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local otherCharacter = otherPlayer.Character
			local otherRoot = getRoot(otherCharacter)

			if otherRoot then
				local distance =
					(otherRoot.Position - root.Position).Magnitude

				if distance < nearestDistance then
					nearest = otherPlayer
					nearestDistance = distance
				end
			end
		end
	end

	return nearest, nearestDistance
end

local function findTimer()
	local character = getCharacter()
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	local containers = {}

	if character then
		table.insert(containers, character)
	end

	if playerGui then
		table.insert(containers, playerGui)
	end

	for _, container in ipairs(containers) do
		for _, object in ipairs(container:GetDescendants()) do
			local name = string.lower(object.Name)

			if object:IsA("NumberValue")
				or object:IsA("IntValue") then

				if string.find(name, "timer")
					or string.find(name, "time")
					or string.find(name, "count")
					or string.find(name, "second") then

					return object.Value
				end
			end

			if object:IsA("TextLabel")
				or object:IsA("TextButton")
				or object:IsA("TextBox") then

				if string.find(name, "timer")
					or string.find(name, "time")
					or string.find(name, "count")
					or string.find(name, "second") then

					local number =
						tonumber(string.match(object.Text, "%d+"))

					if number then
						return number
					end
				end
			end
		end
	end

	for _, attribute in ipairs({
		"Timer",
		"Time",
		"Countdown",
		"CountDown",
		"Seconds",
		"Second"
	}) do
		local value = player:GetAttribute(attribute)

		if typeof(value) == "number" then
			return value
		end
	end

	return nil
end

local function startSpin()
	spinning = true
end

local function stopSpin()
	spinning = false
end

local function doSpin()
	if not enabled then return end
	if currentMode ~= "AUTO" then return end
	if not spinning then return end

	local character = getCharacter()
	local root = getRoot(character)

	if not root then return end

	root.CFrame =
		CFrame.new(root.Position) *
		CFrame.Angles(
			0,
			SPIN_SPEED * os.clock(),
			0
		)
end

local function getClearDirection(character, direction)
	local root = getRoot(character)

	if not root then
		return direction
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	local result = workspace:Raycast(
		root.Position,
		direction.Unit * 12,
		params
	)

	if not result then
		return direction.Unit
	end

	local right = Vector3.new(
		-direction.Z,
		0,
		direction.X
	)

	local choices = {
		(direction + right).Unit,
		(direction - right).Unit,
		right.Unit,
		(-right).Unit
	}

	for _, choice in ipairs(choices) do
		local check =
			workspace:Raycast(
				root.Position,
				choice * 12,
				params
			)

		if not check then
			return choice
		end
	end

	return direction.Unit
end

local function createEscapeTarget(character, targetCharacter)
	local root = getRoot(character)
	local targetRoot = getRoot(targetCharacter)

	if not root or not targetRoot then
		return nil, nil
	end

	local away =
		root.Position - targetRoot.Position

	away = Vector3.new(
		away.X,
		0,
		away.Z
	)

	if away.Magnitude < 0.1 then
		away = -root.CFrame.LookVector

		away = Vector3.new(
			away.X,
			0,
			away.Z
		)
	end

	if away.Magnitude < 0.1 then
		return nil, nil
	end

	away = away.Unit

	local safeDirection =
		getClearDirection(
			character,
			away
		)

	local targetPosition =
		root.Position +
		safeDirection * ESCAPE_DISTANCE

	return safeDirection, targetPosition
end

local function playMode()
	if not enabled then return end

	local character = getCharacter()
	local humanoid = getHumanoid(character)
	local root = getRoot(character)

	if not character or not humanoid or not root then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	humanoid.WalkSpeed = ESCAPE_SPEED

	local nearestPlayer, distance =
		getNearestPlayer()

	if nearestPlayer then
		local targetCharacter =
			nearestPlayer.Character

		local targetRoot =
			getRoot(targetCharacter)

		if targetRoot then
			local now = os.clock()

			local shouldUpdate =
				not escapeTarget
				or now - lastEscapeTime >= 0.08
				or distance <= 12
				or (escapeTarget - root.Position).Magnitude < 10

			if shouldUpdate then
				local direction, target =
					createEscapeTarget(
						character,
						targetCharacter
					)

				if direction and target then
					escapeDirection = direction
					escapeTarget = target
					lastEscapeTime = now
				end
			end

			if escapeTarget then
				humanoid:MoveTo(escapeTarget)
			end

			if distance <= 10 then
				local direction, target =
					createEscapeTarget(
						character,
						targetCharacter
					)

				if direction and target then
					escapeDirection = direction
					escapeTarget = target
					lastEscapeTime = now

					humanoid:MoveTo(escapeTarget)
				end
			end

			return
		end
	end

	if escapeTarget then
		if (escapeTarget - root.Position).Magnitude < 8 then
			escapeTarget =
				root.Position +
				escapeDirection * ESCAPE_DISTANCE
		end

		humanoid:MoveTo(escapeTarget)
		return
	end

	local forward =
		Vector3.new(
			root.CFrame.LookVector.X,
			0,
			root.CFrame.LookVector.Z
		)

	if forward.Magnitude < 0.1 then
		forward = Vector3.new(0, 0, -1)
	end

	escapeDirection =
		getClearDirection(
			character,
			forward.Unit
		)

	escapeTarget =
		root.Position +
		escapeDirection * ESCAPE_DISTANCE

	humanoid:MoveTo(escapeTarget)
end

local function updateMode()
	local tool = getInventoryTool()
	local hasTool = tool ~= nil

	if hasTool then
		currentMode = "AUTO"
	else
		currentMode = "PLAY"
	end

	if hasTool ~= lastToolState then
		lastToolState = hasTool

		if not hasTool then
			stopSpin()
			escapeDirection = nil
			escapeTarget = nil
			lastEscapeTime = 0
		end
	end
end

